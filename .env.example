# Copy to .env.local for local development. Never commit real values.

# Canonical site origin, used for metadataBase, canonical URLs and OG images.
# Fallback order: NEXT_PUBLIC_SITE_URL, then https://$VERCEL_PROJECT_PRODUCTION_URL, then the local server on localhost.
NEXT_PUBLIC_SITE_URL=

# Resend API key for the contact form (server-only; never prefix with NEXT_PUBLIC_).
# Without it in production, the form is replaced by direct email and LinkedIn links.
RESEND_API_KEY=

# Inbox that receives contact-form messages.
CONTACT_TO=gerricmeasco360@gmail.com

# Sender address. Resend's test sender can deliver only to the account owner's own inbox.
CONTACT_FROM=onboarding@resend.dev

# resend = send through Resend; log = print the message to the server log instead of sending it.
# Leave blank for the code default: resend in production (next build, next start), log everywhere
# else (next dev, tests). The e2e server and CI set log.
CONTACT_TRANSPORT=

# Placeholder mode for one build: label (the default in src/content/site.ts) or hide.
# hide = public: pages indexable, sitemap.xml published, placeholder fields and example items removed.
# Lighthouse's SEO audit (target 1.0) needs a hide build; label mode is noindex by design.
NEXT_PUBLIC_PLACEHOLDERS=
